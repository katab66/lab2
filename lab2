git add README.md index.html
git commit -m "Initial commit: README and index.html"
git push -u origin main

git switch -c feature/page
sed -i 's|<h1>Git Lab 2</h1>|<h1>Feature Title</h1>|' index.html
git commit -am "Change title to Feature Title"
git branch -m feature/title

git switch main
sed -i 's|<h1>Git Lab 2</h1>|<h1>Main Title</h1>|' index.html
git commit -am "Change title to Main Title"

git merge feature/title          # будет конфликт
git status
cat index.html                   # маркеры <<<<<<< ======= >>>>>>>

git merge --abort
git status
git merge feature/title          # конфликт снова

awk '/^<<<<<<< /{print "<h1>Main Feature Title</h1>"; skip=1; next} /^>>>>>>> /{skip=0; next} skip{next} {print}' index.html > i.tmp && mv i.tmp index.html
cat index.html

echo "Temporary change" >> README.md
git diff README.md
git add README.md
git diff --staged
git status
git restore --staged README.md
git status
git restore README.md
git status

echo "Draft documentation" >> README.md
git stash
git stash list
git status

git switch -c hotfix/text
sed -i 's|<p>Комплексная работа по Git</p>|<p>Учебный проект Git</p>|' index.html
