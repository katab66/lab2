git switch main
git merge hotfix/text
git stash pop
tail -n 2 README.md
git commit -am "Add draft documentation"
git branch -d hotfix/text
git push

git log --oneline -- index.html
git diff <HASH_1> <HASH_2> -- index.html     # хэши из строки выше
